{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend (FastAPI)",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/ai-backend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "2. Run Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/chatbot-frontend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Run Full Chatbot (Backend + Frontend)",
      "dependsOn": [
        "1. Run Backend (FastAPI)",
        "2. Run Frontend (Next.js)"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
